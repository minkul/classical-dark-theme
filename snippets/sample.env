# Sample .env file covering language tokens.

APP_NAME=classical-dark-theme
APP_ENV=production
DEBUG=false
PORT=3000
TIMEOUT_SECONDS=30.5

# Quoted values
DATABASE_URL="postgres://user:password@localhost:5432/app_db"
GREETING='Hello, World!'
MULTI_WORD="value with spaces"

# Variable expansion
BASE_URL=https://example.com
API_URL=${BASE_URL}/api/v1

export SECRET_KEY=change-me
EMPTY_VALUE=
